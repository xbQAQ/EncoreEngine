# 入口使用同卷临时文件发布；运行中的旧映像仅改名保留，不终止编辑器进程。
foreach(required ENTRY_SOURCE ENTRY_DESTINATION ENTRY_STAGING_DIRECTORY)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing root entry argument: ${required}")
  endif()
endforeach()
if(ENTRY_SOURCE STREQUAL ENTRY_DESTINATION)
  return()
endif()
file(MAKE_DIRECTORY "${ENTRY_STAGING_DIRECTORY}")
file(LOCK "${ENTRY_STAGING_DIRECTORY}/publish.lock" GUARD PROCESS TIMEOUT 30)
file(SHA256 "${ENTRY_SOURCE}" source_hash)
if(EXISTS "${ENTRY_DESTINATION}")
  file(SHA256 "${ENTRY_DESTINATION}" entry_hash)
  if(source_hash STREQUAL entry_hash)
    return()
  endif()
endif()

# 同卷暂存文件使用引擎名称区分发布入口，完整复制后再替换，避免留下半份可执行文件。
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef serial)
set(staged "${ENTRY_STAGING_DIRECTORY}/EncoreEngine-${serial}.pending")
file(COPY_FILE "${ENTRY_SOURCE}" "${staged}" RESULT copy_result)
if(NOT copy_result STREQUAL "0")
  file(REMOVE "${staged}")
  message(FATAL_ERROR "Cannot stage root entry: ${copy_result}")
endif()
file(RENAME "${staged}" "${ENTRY_DESTINATION}" RESULT publish_result)
if(publish_result STREQUAL "0")
  return()
endif()

# Windows 不允许覆盖正在执行的映像，但允许将其改名，新入口仍指向最新版本。
if(EXISTS "${ENTRY_DESTINATION}")
  set(backup "${ENTRY_STAGING_DIRECTORY}/EncoreEngine-${serial}.exe")
  file(RENAME "${ENTRY_DESTINATION}" "${backup}" RESULT backup_result NO_REPLACE)
  if(backup_result STREQUAL "0")
    file(RENAME "${staged}" "${ENTRY_DESTINATION}" RESULT retry_result)
    if(retry_result STREQUAL "0")
      message(STATUS "Root entry updated; running executable retained at: ${backup}")
      return()
    endif()
    # 新入口发布失败时尝试恢复原入口，并保留真实错误，禁止将失败标记为构建成功。
    file(RENAME "${backup}" "${ENTRY_DESTINATION}" RESULT restore_result NO_REPLACE)
    file(REMOVE "${staged}")
    message(FATAL_ERROR "Cannot publish root entry: ${retry_result}; restore result: ${restore_result}")
  endif()
endif()
file(REMOVE "${staged}")
message(FATAL_ERROR "Cannot publish root entry: ${publish_result}")
